@startuml
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #54718B
skinparam classBackgroundColor #F3F8FC
skinparam classBorderColor #355C7D
skinparam componentBackgroundColor #F3F8FC
skinparam componentBorderColor #355C7D
skinparam stateBackgroundColor #F3F8FC
skinparam stateBorderColor #355C7D
skinparam nodesep 45
skinparam ranksep 50
title 互动扩展数据关系
hide methods
class User {
id: PK
}
class Product {
id: PK
}
class Favorite {
user_id / product_id: PK
created_at
}
class Browsing {
user_id / product_id: PK
viewed_at
}
class Follow {
user_id / seller_id: PK
user_id != seller_id
}
class Conversation {
id: PK
product_id / buyer_id: UNIQUE
seller_id / snapshot_title
}
class Message {
id: PK
conversation_id / sender_id: FK
sender_id / request_key: UNIQUE
content / created_at / read_at
}
class TradeReview {
id: PK
reservation_id / author_id: UNIQUE
target_id / score: 1..5
content / visible
}
class ReviewReport {
id: PK
review_id / reporter_id: UNIQUE
state / handled_by / reason
}
User "1" -- "0..*" Favorite
User "1" -- "0..*" Browsing
User "1" -- "0..*" Follow
Product "1" -- "0..*" Favorite
Product "1" -- "0..*" Browsing
Product "1" -- "0..*" Conversation
Conversation "1" -- "0..*" Message
User "1" -- "0..*" TradeReview : 被评价
TradeReview "1" -- "0..*" ReviewReport
legend bottom
  咨询会话仅买卖双方可读取或发送，消息每页50条。
  评价必须来自已完成交易，一人一交易最多一条，公开统计仅含可见真实评价。
  收藏不可公开商品仅显示统一不可用标记；咨询标题保留建立时快照。
endlegend
@enduml
