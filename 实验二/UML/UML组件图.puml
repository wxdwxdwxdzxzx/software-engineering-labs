@startuml
title 二手交易系统｜组件与模块交互
skinparam defaultFontName Microsoft YaHei
skinparam backgroundColor #FFFFFF
skinparam componentBackgroundColor #F3F8FC
skinparam componentBorderColor #355C7D
skinparam ArrowColor #54718B
skinparam shadowing false
skinparam linetype ortho
left to right direction
actor 普通用户 as User
actor 管理员 as Admin
component "买卖家界面" as Front
component "管理后台" as Back
component "权限入口" as Gateway
package "业务模块" {
 component "商品与审核" as Product
 component "预约与交易" as Booking
 component "举报与通知" as Moderation
 component "查询与统计" as Query
 component "操作日志" as Audit
}
component "24小时超时任务" as Timeout
component "数据访问" as Data
database "业务数据库" as DB
User --> Front
Admin --> Back
Front --> Gateway
Back --> Gateway
Gateway --> Product
Gateway --> Booking
Gateway --> Moderation
Gateway --> Query
Gateway --> Audit
Booking --> Product
Moderation --> Booking
Timeout --> Booking
Product --> Data
Booking --> Data
Moderation --> Data
Query --> Data
Audit --> Data
Data --> DB
note bottom of Data
 状态更新和日志写入保持一致；
 历史预约、举报与日志不物理删除。
end note
@enduml

